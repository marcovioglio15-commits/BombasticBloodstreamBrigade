          warningRadiusScale: 1
          ringWidth: 0.08
          heightOffset: 0.04
          maximumAlpha: 0.85
          fadeOutSeconds: 0.12
          color: {r: 1, g: 0.35, b: 0.05, a: 1}
      powerUpStealer:
