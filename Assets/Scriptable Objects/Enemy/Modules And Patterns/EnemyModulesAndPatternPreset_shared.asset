            impedimentSlowPercentPerStack: 10
            impedimentProcSlowPercent: 50
            impedimentMaxSlowPercent: 100
            impedimentDurationSeconds: 2
          stacksPerHit: 1
      bombardier:
        aimPolicy: 0
        movementPolicy: 0
        fireInterval: 2
        burstCount: 1
        aimWindupSeconds: 0.45
        preLaunchStopSeconds: 0.35
        postLaunchStopSeconds: 0.15
        intraBurstDelay: 0.15
        inReachTargetingMode: 1
        outOfReachTargetingMode: 0
        launchPattern: 0
        bombsPerLaunch: 1
        landingSpreadRadius: 1.25
        radialPatternRadius: 2
        randomMinimumDistance: 2
        randomMaximumDistance: 8
        trajectoryMode: 0
        flightDurationSeconds: 1.15
        gravity: 16
        apexHeight: 3
        launchHeightOffset: 0.65
        landingHeightOffset: 0
        damage: 12
        damageRadius: 1.75
        impactExplosionDelaySeconds: 0
        bombScaleMultiplier: 1
        preventMidAirInterception: 1
        runtimeBomb:
          bombPrefab: {fileID: 0}
          explosionVfxPrefab: {fileID: 0}
          scaleExplosionVfxToDamageRadius: 1
          explosionVfxScaleMultiplier: 1
        landingWarning:
